rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function me() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function isTeacher() { return signed() && me().role == 'teacher'; }
    function asg(aid) { return get(/databases/$(db)/documents/assignments/$(aid)).data; }
    function inClass(cid) { return signed() && me().classIds.hasAny([cid]); }
    match /users/{uid} {
      allow read: if signed() && (request.auth.uid == uid || resource.data.teacherId == request.auth.uid);
      allow create: if signed() && ((request.auth.uid == uid && request.resource.data.role == 'teacher' && request.resource.data.teacherId == uid) || (isTeacher() && request.resource.data.role == 'student' && request.resource.data.teacherId == request.auth.uid));
      allow update: if signed() && resource.data.teacherId == request.auth.uid && request.resource.data.teacherId == resource.data.teacherId && request.resource.data.role == resource.data.role;
    }
    match /classes/{cid} {
      allow read: if signed() && (resource.data.teacherId == request.auth.uid || inClass(cid));
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if signed() && resource.data.teacherId == request.auth.uid;
    }
    match /lessons/{lid} {
      allow read: if signed() && (resource.data.teacherId == request.auth.uid || resource.data.classIds.hasAny(me().classIds));
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if signed() && resource.data.teacherId == request.auth.uid;
      match /parts/{p} {
        allow read: if signed() && (get(/databases/$(db)/documents/lessons/$(lid)).data.teacherId == request.auth.uid || get(/databases/$(db)/documents/lessons/$(lid)).data.classIds.hasAny(me().classIds));
        allow write: if signed() && get(/databases/$(db)/documents/lessons/$(lid)).data.teacherId == request.auth.uid;
      }
    }
    match /assignments/{aid} {
      allow read: if signed() && (resource.data.teacherId == request.auth.uid || inClass(resource.data.classId));
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if signed() && resource.data.teacherId == request.auth.uid;
      match /results/{uid} {
        allow read, delete: if signed() && (request.auth.uid == uid || asg(aid).teacherId == request.auth.uid);
        allow create, update: if signed() && request.auth.uid == uid && inClass(asg(aid).classId);
      }
    }
    match /live/{aid} {
      allow read: if signed() && (asg(aid).teacherId == request.auth.uid || inClass(asg(aid).classId));
      allow write: if signed() && asg(aid).teacherId == request.auth.uid;
      match /answers/{uid} {
        allow read: if signed() && (request.auth.uid == uid || asg(aid).teacherId == request.auth.uid);
        allow write: if signed() && request.auth.uid == uid && inClass(asg(aid).classId);
      }
    }
  }
}
