rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function me() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function isTeacher() { return signed() && me().role == 'teacher'; }
    function asg(aid) { return get(/databases/$(db)/documents/assignments/$(aid)).data; }
    function inClass(cid) { return signed() && me().classIds.hasAny([cid]); }
    function lessonOf(lid) { return get(/databases/$(db)/documents/lessons/$(lid)).data; }
    function liveOk(aid) { return asg(aid).get('guest', false) == true || inClass(asg(aid).classId); }
    function qz(q) { return get(/databases/$(db)/documents/quizzes/$(q)).data; }
    function qzOk(q) { return qz(q).get('guest', false) == true || inClass(qz(q).classId); }
    function isAdmin() { return signed() && request.auth.token.email == 'kieuoanhvo89@gmail.com'; }
    match /users/{uid} {
      allow read: if signed() && (request.auth.uid == uid || resource.data.teacherId == request.auth.uid);
      allow create: if signed() && ((request.auth.uid == uid && request.resource.data.role == 'teacher' && request.resource.data.teacherId == uid) || (isTeacher() && request.resource.data.role == 'student' && request.resource.data.teacherId == request.auth.uid));
      allow update: if signed() && ((resource.data.teacherId == request.auth.uid && request.resource.data.teacherId == resource.data.teacherId && request.resource.data.role == resource.data.role) || (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pw'])));
    }
    match /classes/{cid} {
      allow read: if signed() && (resource.data.teacherId == request.auth.uid || inClass(cid));
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if signed() && resource.data.teacherId == request.auth.uid;
    }
    match /lessons/{lid} {
      allow read: if signed() && (resource.data.teacherId == request.auth.uid || resource.data.get('guestOpen', false) == true || resource.data.classIds.hasAny(me().classIds));
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if signed() && resource.data.teacherId == request.auth.uid;
      match /parts/{p} {
        allow read: if signed() && (lessonOf(lid).teacherId == request.auth.uid || lessonOf(lid).get('guestOpen', false) == true || lessonOf(lid).classIds.hasAny(me().classIds));
        allow write: if signed() && lessonOf(lid).teacherId == request.auth.uid;
      }
    }
    match /brands/{tid} {
      allow read: if true;
      allow create, update: if signed() && request.auth.uid == tid && request.resource.data.keys().hasOnly(['n','logo','at']);
      allow delete: if signed() && request.auth.uid == tid;
    }
    match /licenses/{tid} {
      allow read: if signed() && (request.auth.uid == tid || isAdmin());
      allow create: if signed() && ((request.auth.uid == tid && request.auth.token.email_verified == true && request.resource.data.plan == 'trial' && request.resource.data.until <= request.time.toMillis() + 5184600000 && request.resource.data.keys().hasOnly(['name','email','plan','until','createdAt'])) || isAdmin());
      allow update, delete: if isAdmin();
    }
    match /trials/{key} {
      allow read: if isAdmin();
      allow create: if signed() && request.auth.token.email_verified == true && request.resource.data.uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid','at']);
      allow update, delete: if isAdmin();
    }
    match /payreqs/{id} {
      allow read: if signed() && (isAdmin() || resource.data.tid == request.auth.uid);
      allow create: if isTeacher() && request.resource.data.tid == request.auth.uid && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }
    match /feedback/{id} {
      allow read: if signed() && (isAdmin() || resource.data.tid == request.auth.uid);
      allow create: if isTeacher() && request.resource.data.tid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /config/{id} {
      allow read: if signed();
      allow write: if isAdmin();
    }
    match /notes/{sid} {
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid && request.resource.data.teacherId == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }
    match /assignments/{aid} {
      allow read: if signed() && (resource.data.teacherId == request.auth.uid || resource.data.get('guest', false) == true || inClass(resource.data.classId));
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if signed() && resource.data.teacherId == request.auth.uid;
      match /results/{uid} {
        allow read, delete: if signed() && (request.auth.uid == uid || asg(aid).teacherId == request.auth.uid);
        allow create, update: if signed() && request.auth.uid == uid && liveOk(aid);
      }
    }
    match /live/{aid} {
      allow read: if signed() && (asg(aid).teacherId == request.auth.uid || liveOk(aid));
      allow write: if signed() && asg(aid).teacherId == request.auth.uid;
      match /ink/{k} {
        allow read: if signed() && (asg(aid).teacherId == request.auth.uid || liveOk(aid));
        allow write: if signed() && (asg(aid).teacherId == request.auth.uid || (liveOk(aid) && k.matches('^[0-9]+_' + request.auth.uid + '$') && request.auth.uid in get(/databases/$(db)/documents/live/$(aid)).data.draw));
      }
      match /who/{uid} {
        allow read: if signed() && asg(aid).teacherId == request.auth.uid;
        allow write: if signed() && request.auth.uid == uid && liveOk(aid);
      }
    }
    match /quizzes/{qid} {
      allow read: if signed() && (resource.data.teacherId == request.auth.uid || resource.data.get('guest', false) == true || inClass(resource.data.classId));
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if signed() && resource.data.teacherId == request.auth.uid;
      match /pl/{uid} {
        allow read: if signed() && (request.auth.uid == uid || qz(qid).teacherId == request.auth.uid);
        allow create, update: if signed() && request.auth.uid == uid && qz(qid).status != 'end' && qzOk(qid);
        allow delete: if signed() && qz(qid).teacherId == request.auth.uid;
      }
    }
    match /notices/{id} {
      allow read: if signed() && (resource.data.to == request.auth.uid || resource.data.teacherId == request.auth.uid);
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if signed() && resource.data.to == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signed() && (resource.data.to == request.auth.uid || resource.data.teacherId == request.auth.uid);
    }
  }
}
